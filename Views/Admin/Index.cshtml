@model IEnumerable<NextStepMVC.Models.Opportunity>
@using System.Linq
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg admin-navbar">
    <div class="container">

        <a class="navbar-brand admin-brand"
           asp-controller="Home"
           asp-action="Index">
            🎓NextStep.
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#adminNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link active"
                       asp-controller="Admin"
                       asp-action="Index">
                        Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#manage-opportunities">
                        Manage Opportunities
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area="Identity"
                       asp-page="/Account/Logout">
                        Logout
                    </a>
                </li>

            </ul>

        </div>
    </div>
</nav>


<!-- Admin Hero Section -->
<section class="admin-hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="admin-hero-badge">
                    ADMINISTRATOR PANEL
                </span>

                <h1>
                    Welcome to Your
                    <span>Dashboard!</span>
                </h1>

                <p>
                    Manage internships and scholarships,
                    keep opportunities updated, and help
                    students discover their next step.
                </p>

            </div>

            <div class="col-lg-4 text-center mt-4 mt-lg-0">

                <div class="admin-hero-icon">
                    ⚙️
                </div>

            </div>

        </div>

    </div>

</section>



<!-- Dashboard Overview -->
<section class="admin-overview">

    <div class="container">

        <div class="admin-section-heading">
            <h2>Dashboard Overview</h2>
            <p>A quick overview of opportunity management.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <div class="admin-stat-card">
                    <div class="admin-stat-icon">📋</div>
                    <h3>All Opportunities</h3>
                    <p><span id="totalCount">@Model.Count()</span> opportunities available.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="admin-stat-card">
                    <div class="admin-stat-icon">💼</div>
                    <h3>Internships</h3>
                    <p><span id="internshipCount">@Model.Count(o => o.Type == "Internship")</span> internships available.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="admin-stat-card">
                    <div class="admin-stat-icon">🏆</div>
                    <h3>Scholarships</h3>
                    <p><span id="scholarshipCount">@Model.Count(o => o.Type == "Scholarship")</span> scholarships available.</p>
                </div>
            </div>

        </div>

    </div>

</section>



<!-- Quick Actions -->
<section class="admin-actions">

    <div class="container">

        <div class="admin-section-heading">
            <h2>Manage Opportunities</h2>
            <p>Choose an action to manage website listings.</p>
        </div>

        <div class="row g-4">

            <!-- Add Internship -->
            <div class="col-md-6 col-lg-4">

                <div class="admin-action-card">

                    <div class="admin-action-icon">💼</div>

                    <h3>Add Internship</h3>

                    <p>
                        Create a new internship listing
                        for students.
                    </p>

                    <a asp-controller="Opportunity"
                       asp-action="Create"
                       asp-route-type="Internship"
                       class="admin-action-btn">
                        Add Internship →
                    </a>

                </div>

            </div>


            <!-- Add Scholarship -->
            <div class="col-md-6 col-lg-4">

                <div class="admin-action-card">

                    <div class="admin-action-icon">🏆</div>

                    <h3>Add Scholarship</h3>

                    <p>
                        Publish new scholarship opportunities
                        for students.
                    </p>

                    <a asp-controller="Opportunity"
                       asp-action="Create"
                       asp-route-type="Scholarship"
                       class="admin-action-btn">
                        Add Scholarship →
                    </a>

                </div>

            </div>


            <!-- View Opportunities -->
            <div class="col-md-6 col-lg-4">

                <div class="admin-action-card">

                    <div class="admin-action-icon">📚</div>

                    <h3>View Listings</h3>

                    <p>
                        Review and manage existing
                        opportunities.
                    </p>

                    <a href="#manage-opportunities"
                       class="admin-action-btn">
                        View Listings →
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- Manage Opportunities Table -->
<section class="admin-manage-section" id="manage-opportunities">

    <div class="container">

        <div class="admin-section-heading">
            <h2>Existing Opportunities</h2>
            <p>Review the opportunities currently listed on NextStep.</p>
        </div>

        <div class="table-responsive admin-table-wrapper">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Opportunity</th>
                        <th>Type</th>
                        <th>Organization</th>
                        <th>Deadline</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="opportunityTableBody">
                    @await Html.PartialAsync("_OpportunityRows", Model)
                </tbody>

            </table>

        </div>

    </div>

</section>



<!-- Footer -->
<footer class="admin-footer">

    <div class="container text-center">

        <h4>🎓 NextStep<span>.</span></h4>

        <p>Find Opportunities. Shape Your Future.</p>

        <p class="admin-footer-copy">
            © 2026 NextStep. All Rights Reserved.
        </p>

    </div>

</footer>

@section Scripts {
    <script>
        $(document).ready(function () {

            $(document).on("submit", ".delete-opportunity-form", function (e) {

                e.preventDefault();

                var form = $(this);
                var url = form.attr("action");

                var token = form.find('input[name="__RequestVerificationToken"]').val();

                if (confirm("Are you sure you want to delete this opportunity?")) {

                    $.post(url, {
                        __RequestVerificationToken: token
                    }, function (data) {

                        $("#opportunityTableBody").html(data);

                        var total = $("#opportunityTableBody tr").filter(function () {
                            return $(this).find("td").length === 6;
                        }).length;

                        var internships = $("#opportunityTableBody tr").filter(function () {
                            return $(this).find("td:eq(1)").text().trim() === "Internship";
                        }).length;

                        var scholarships = $("#opportunityTableBody tr").filter(function () {
                            return $(this).find("td:eq(1)").text().trim() === "Scholarship";
                        }).length;

                        $("#totalCount").text(total);
                        $("#internshipCount").text(internships);
                        $("#scholarshipCount").text(scholarships);

                    });

                }

            });

        });
    </script>
}

