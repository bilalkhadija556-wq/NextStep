@model IEnumerable<NextStepMVC.Models.Opportunity>

@using System.Linq

@{
    ViewData["Title"] = "Student Dashboard";
}

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg student-navbar">
    <div class="container">

        <a class="navbar-brand student-brand"
           asp-controller="Student"
           asp-action="Index">
            🎓 NextStep<span>.</span>
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#studentNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="studentNavbar">

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#internships">
                        Internships
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#scholarships">
                        Scholarships
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       asp-area="Identity"
                       asp-page="/Account/Logout">
                        Logout
                    </a>
                </li>

            </ul>

        </div>
    </div>
</nav>


<!-- Hero Section -->
<section class="student-hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="student-hero-badge">
                    YOUR FUTURE STARTS HERE
                </span>

                <h1>
                    Welcome to Your
                    <span>NextStep!</span>
                </h1>

                <p>
                    Explore internships, discover scholarships,
                    and find opportunities that bring you closer
                    to your career and educational goals.
                </p>

                <a href="#opportunities" class="btn student-explore-btn">
                    Explore Opportunities
                </a>

            </div>

            <div class="col-lg-5 text-center mt-5 mt-lg-0">

                <div class="student-hero-icon">
                    🎓
                </div>

            </div>

        </div>

    </div>

</section>



<!-- Search Section -->
<section class="student-search-section">

    <div class="container">

        <div class="student-search-box">

            <h3>Find the Right Opportunity</h3>

            <p>
                Search for internships and scholarships that match your interests.
            </p>

            <form asp-controller="Student" asp-action="Index"
                  method="get" class="row g-2">

                <div class="col-md-9">
                    <input type="text" name="search" value="@Context.Request.Query["search"]"
                           class="form-control"
                           placeholder="Search by title or organization">
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn student-search-btn w-100">
                        Search
                    </button>
                </div>

            </form>

        </div>

    </div>

</section>



<!-- Opportunity Categories -->
<section class="student-categories" id="opportunities">

    <div class="container">

        <div class="student-section-heading">
            <h2>Explore Opportunities</h2>

            <p>
                Choose the type of opportunity you are looking for.
            </p>
        </div>

        <div class="row g-4">

            <!-- Internship Category -->
            <div class="col-md-6" id="internships">

                <div class="student-category-card">

                    <div class="student-category-icon">
                        💼
                    </div>

                    <h3>Internships</h3>

                    <p>
                        Gain practical experience, develop your skills,
                        and explore career opportunities.
                    </p>

                    <a href="#featured-internships">
                        Explore Internships →
                    </a>

                </div>

            </div>


            <!-- Scholarship Category -->
            <div class="col-md-6" id="scholarships">

                <div class="student-category-card">

                    <div class="student-category-icon">
                        🏆
                    </div>

                    <h3>Scholarships</h3>

                    <p>
                        Discover financial support opportunities
                        to continue your educational journey.
                    </p>

                    <a href="#featured-scholarships">
                        Explore Scholarships →
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Featured Internships -->
<section class="student-featured-section" id="featured-internships">

    <div class="container">

        <div class="student-section-heading">
            <h2>Featured Internships</h2>
            <p>Explore internship opportunities to build your experience.</p>
        </div>

        <div class="row g-4">

            @if (Model.Any(o => o.Type == "Internship"))
            {
                @foreach (var opportunity in Model.Where(o => o.Type == "Internship"))
                {
                    var daysLeft = (opportunity.Deadline.Date - DateTime.Today).Days;

                    <div class="col-md-6 col-lg-4">

                        <div class="student-opportunity-card">

                            @if (daysLeft < 0)
                            {
                                <span class="opportunity-status closing-status">
                                    Closed
                                </span>
                            }
                            else if (daysLeft <= 7)
                            {
                                <span class="opportunity-status closing-status">
                                    Closing Soon
                                </span>
                            }
                            else
                            {
                                <span class="opportunity-status open-status">
                                    Open
                                </span>
                            }

                            <h4>@opportunity.Title</h4>

                            <p class="opportunity-organization">
                                @opportunity.Organization
                            </p>

                            <p>
                                @opportunity.Description
                            </p>

                            <p>
                                <strong>Location:</strong> @opportunity.Location
                            </p>

                            <div class="opportunity-deadline">
                                <strong>Deadline:</strong>
                                @opportunity.Deadline.ToString("dd MMMM yyyy")
                            </div>

                            @if (daysLeft >= 0)
                            {
                                <a href="@opportunity.ApplicationLink"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="student-view-btn">
                                    Apply Now →
                                </a>
                            }
                            else
                            {
                                <span class="student-view-btn">
                                    Applications Closed
                                </span>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p>No internships are available at the moment.</p>
                </div>
            }

        </div>

    </div>

</section>


<!-- Featured Scholarships -->
<section class="student-featured-section scholarship-featured"
         id="featured-scholarships">

    <div class="container">

        <div class="student-section-heading">
            <h2>Featured Scholarships</h2>
            <p>Find financial support for your education.</p>
        </div>

        <div class="row g-4">

            @if (Model.Any(o => o.Type == "Scholarship"))
            {
                @foreach (var opportunity in Model.Where(o => o.Type == "Scholarship"))
                {
                    var daysLeft = (opportunity.Deadline.Date - DateTime.Today).Days;

                    <div class="col-md-6 col-lg-4">

                        <div class="student-opportunity-card">

                            @if (daysLeft < 0)
                            {
                                <span class="opportunity-status closing-status">
                                    Closed
                                </span>
                            }
                            else if (daysLeft <= 7)
                            {
                                <span class="opportunity-status closing-status">
                                    Closing Soon
                                </span>
                            }
                            else
                            {
                                <span class="opportunity-status open-status">
                                    Open
                                </span>
                            }

                            <h4>@opportunity.Title</h4>

                            <p class="opportunity-organization">
                                @opportunity.Organization
                            </p>

                            <p>
                                @opportunity.Description
                            </p>

                            <p>
                                <strong>Location:</strong> @opportunity.Location
                            </p>

                            <div class="opportunity-deadline">
                                <strong>Deadline:</strong>
                                @opportunity.Deadline.ToString("dd MMMM yyyy")
                            </div>

                            @if (daysLeft >= 0)
                            {
                                <a href="@opportunity.ApplicationLink"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="student-view-btn">
                                    Apply Now →
                                </a>
                            }
                            else
                            {
                                <span class="student-view-btn">
                                    Applications Closed
                                </span>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p>No scholarships are available at the moment.</p>
                </div>
            }

        </div>

    </div>

</section>


<!-- Footer -->
<footer class="student-footer">

    <div class="container text-center">

        <h4>🎓 NextStep<span>.</span></h4>

        <p>
            Find Opportunities. Shape Your Future.
        </p>

        <p class="student-footer-copy">
            © 2026 NextStep. All Rights Reserved.
        </p>

    </div>

</footer>
