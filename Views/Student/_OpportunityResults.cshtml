@model IEnumerable<NextStepMVC.Models.Opportunity>

@using System.Linq

<!-- Featured Internships -->
<section class="student-featured-section" id="featured-internships">

    <div class="container">

        <div class="student-section-heading">
            <h2>Featured Internships</h2>
            <p>Explore internship opportunities to build your experience.</p>
        </div>

        <div class="row g-4">

            @if (Model.Any(o => o.Type == "Internship"))
            {
                @foreach (var opportunity in Model.Where(o => o.Type == "Internship"))
                {
                    var daysLeft = (opportunity.Deadline.Date - DateTime.Today).Days;

                    <div class="col-md-6 col-lg-4">
                        <div class="student-opportunity-card">

                            @if (daysLeft < 0)
                            {
                                <span class="opportunity-status closing-status">Closed</span>
                            }
                            else if (daysLeft <= 7)
                            {
                                <span class="opportunity-status closing-status">Closing Soon</span>
                            }
                            else
                            {
                                <span class="opportunity-status open-status">Open</span>
                            }

                            <h4>@opportunity.Title</h4>

                            <p class="opportunity-organization">
                                @opportunity.Organization
                            </p>

                            <p>@opportunity.Description</p>

                            <p>
                                <strong>Location:</strong> @opportunity.Location
                            </p>

                            <div class="opportunity-deadline">
                                <strong>Deadline:</strong>
                                @opportunity.Deadline.ToString("dd MMMM yyyy")
                            </div>

                            @if (daysLeft >= 0)
                            {
                                <a href="@opportunity.ApplicationLink"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="student-view-btn">
                                    Apply Now →
                                </a>
                            }
                            else
                            {
                                <span class="student-view-btn">
                                    Applications Closed
                                </span>
                            }

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p>No internships are available at the moment.</p>
                </div>
            }

        </div>
    </div>
</section>


