@model IEnumerable<NextStepMVC.Models.Opportunity>

@{
    ViewData["Title"] = "Manage Opportunities";
}
<div class="container py-5">
    <h2 class="mb-4">All Opportunities</h2>
    <div class="mb-4">
        <a asp-controller="Admin" asp-action="Index"
           class="btn btn-secondary">
            Back to Admin Dashboard
        </a>
    </div>
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Title</th>
                        <th>Organization</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Deadline</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var opportunity in Model)
                    {
                        <tr>
                            <td>@opportunity.Title</td>
                            <td>@opportunity.Organization</td>
                            <td>@opportunity.Type</td>
                            <td>@opportunity.Location</td>
                            <td>@opportunity.Deadline.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>No opportunities have been added yet.</p>
    }
</div>

